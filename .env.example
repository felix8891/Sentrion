# Local demo settings. Change the session secret before any deployment.
SENTRION_SESSION_SECRET=replace-with-a-long-random-secret
SENTRION_HTTPS_ONLY=false
SENTRION_MAX_UPLOAD_MB=10
SENTRION_DEFAULT_CURRENCY=USD
SENTRION_DATA_DIR=./data
SENTRION_DB_PATH=./data/sentrion.db

# External AI is OFF by default. When enabled, extracted invoice text is sent to the configured provider.
# Use synthetic data for demos unless you have approved data-handling arrangements.
SENTRION_ENABLE_EXTERNAL_AI=false
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. For Google Gemini, use https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
SENTRION_AI_TIMEOUT_SECONDS=12
SENTRION_AI_TOTAL_BUDGET_SECONDS=24
SENTRION_AI_MAX_RETRIES=1
